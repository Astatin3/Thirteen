<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <dev.astatin3.thirteen.ui.views.SortingChip
            android:id="@+id/sortingChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:listitem="@layout/item_playlist_grid"
            tools:spanCount="2"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/noElementsLinearLayout"
            style="@style/Theme.Thirteen.NoElements.LinearLayout"
            android:layout_gravity="center"
            android:visibility="gone">

            <ImageView
                style="@style/Theme.Thirteen.NoElements.ImageView"
                android:contentDescription="@string/no_playlists"
                android:src="@drawable/ic_playlist_play" />

            <Space style="@style/Theme.Thirteen.NoElements.Space" />

            <TextView
                style="@style/Theme.Thirteen.NoElements.TextView"
                android:text="@string/no_playlists_comma" />

            <Button
                android:id="@+id/createNewPlaylistButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/create_playlist_suggestion" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/linearProgressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/createNewPlaylistFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/create_playlist"
            android:src="@drawable/ic_playlist_add"
            android:visibility="visible"
            app:fabSize="normal" />

    </FrameLayout>

</LinearLayout>
